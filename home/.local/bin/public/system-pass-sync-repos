#!/usr/bin/env bash
set -euo pipefail

PASSWORD_STORE_DIR="${PASSWORD_STORE_DIR:-$HOME/.secrets/passwords}"
[ ! -d "$PASSWORD_STORE_DIR" ] && exit 0

cd "$PASSWORD_STORE_DIR"

# skip if any git process is running in this repo
if pgrep -a git | grep -q "$PASSWORD_STORE_DIR"; then
  exit 0
fi

# pull remote changes
output=$(git pull --rebase 2>&1)

if echo "$output" | grep -q 'CONFLICT\|error: could not apply'; then
  notify-send -u critical -i emblem-error "Password Store" "Merge conflict! Manual resolution needed"
  git rebase --abort
  exit 1
fi

# push local changes
git push 2>&1

notify-send -i emblem-synchronizing "Password Store" "Synced"
