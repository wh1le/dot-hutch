#!/usr/bin/env zsh

source "${XDG_CONFIG_HOME:-$HOME/.config}/fzf/common.zsh" || exit 1
active_sessions=("${(@f)$(tmux list-sessions -F '#S' 2>/dev/null)}")

if [[ $# -eq 1 ]]; then
  selected=$1
else
  selected=$({
    printf '%s\n' "${active_sessions[@]}"
    _list_project_dirs 2>/dev/null
  } | fzf_path_pick) || exit 0
fi

if [[ -z $selected ]]; then
  exit 0
fi

if (( ${active_sessions[(Ie)$selected]} )); then
  selected_name="$selected"
else
  selected_name=$(basename "$selected" | tr . _)
fi

if ! tmux has-session -t="$selected_name" 2>/dev/null; then
  tmux new-session -ds "$selected_name" -c "$selected"
fi

if [[ -z $TMUX ]] && ! pgrep -x tmux &>/dev/null; then
  tmux attach-session -t "$selected_name"
elif [[ -n $TMUX ]]; then
  tmux switch-client -t "$selected_name"
else
  tmux attach-session -t "$selected_name"
fi
