#!/usr/bin/env bash

set -euo pipefail

MAC="4C:87:5D:26:F0:C7"
NAME="Bose NC 700"

TRIES="${1:-3}"
SLEEP="${2:-3}"

bluetoothctl power on >/dev/null || true
bluetoothctl trust "$MAC" >/dev/null

i=0
while [ "$i" -lt "$TRIES" ]; do
  i=$((i + 1))
  # notify-send "attempt connecting $i/$TRIES: connect $NAME"
  # Request playback even when Bluetooth is already connected without audio.
  if bluetoothctl connect "$MAC" a2dp-sink; then
    notify-send "$NAME playback connected"
    exit 0
  fi

  # if adapter got wonky, nudge it
  if ! bluetoothctl show | grep -q 'Powered: yes'; then
    rfkill unblock bluetooth || true
    bluetoothctl power on || true
  fi

  sleep "$SLEEP"
done

notify-send "Failed to connect $NAME playback"
exit 1
