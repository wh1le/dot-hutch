#!/usr/bin/env bash
set -euo pipefail

cache="$HOME/.cache/nerd-fonts/glyphs.txt"

update() {
  mkdir -p "${cache%/*}"
  curl -sL "https://raw.githubusercontent.com/ryanoasis/nerd-fonts/master/glyphnames.json" |
    jq -r 'to_entries[] | select(.key != "METADATA") | "\(.value.char)\t\(.key)"' | sort -k2 -t$'\t' >"$cache"
}

case "${1:-list}" in
  --update | update)
    update
    ;;
  list)
    [[ -f "$cache" ]] || update
    awk -F'\t' '{print $1" "$2}' "$cache"
    ;;
  select)
    line="${2:-}"
    [[ -z "$line" ]] && exit 0
    icon="${line%% *}"
    name="${line#* }"
    echo -n "$icon" | copyq copy -
    notify-send "Copied" "$icon  $name"
    ;;
esac
