#!/usr/bin/env bash
set -euo pipefail

declare -A actions=(
  ["󰌾  Lock"]="loginctl lock-session"
  ["󰗽  Logout"]="i3-msg exit"
  ["󰤄  Suspend"]="systemctl suspend"
  ["󰒲  Hibernate"]="systemctl hibernate"
  ["󰜉  Reboot"]="systemctl reboot"
  ["󰐥  Shutdown"]="systemctl poweroff"
)

order=("󰌾  Lock" "󰗽  Logout" "󰤄  Suspend" "󰒲  Hibernate" "󰜉  Reboot" "󰐥  Shutdown")

case "${1:-list}" in
  list)
    printf '%s\n' "${order[@]}"
    ;;
  select)
    choice="${2:-}"
    [[ -z "$choice" ]] && exit 0
    cmd="${actions[$choice]:-}"
    [[ -z "$cmd" ]] && exit 0
    exec $cmd
    ;;
esac
