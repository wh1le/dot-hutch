#!/usr/bin/env bash

set -euo pipefail

bookmarks_file="${HOME}/.config/qutebrowser/bookmarks/urls"
quickmarks_file="${HOME}/.config/qutebrowser/quickmarks"

list=""

# bookmarks: "URL TITLE"
if [[ -f "$bookmarks_file" ]]; then
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    url="${line%% *}"
    title="${line#* }"
    list+="${title} | ${url}"$'\n'
  done < "$bookmarks_file"
fi

# quickmarks: "NAME URL"
if [[ -f "$quickmarks_file" ]]; then
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    name="${line%% *}"
    url="${line##* }"
    list+="${name} | ${url}"$'\n'
  done < "$quickmarks_file"
fi

[[ -z "$list" ]] && { echo "No bookmarks found"; exit 1; }

choice=$(
  echo -n "$list" |
    fzm --dmenu --tty -p "--prompt='bookmarks> '"
) || exit 0

[[ -z "${choice:-}" ]] && exit 0

url="${choice##* | }"

if [[ "$BROWSER" == *"qutebrowser"* ]]; then
  qutebrowser ":open -t $url"
  hyprctl dispatch focuswindow "class:org.qutebrowser.qutebrowser"
else
  $BROWSER "$url"
fi
