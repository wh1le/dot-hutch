if [[ -n "$TMUX" ]]; then
  export TERM="tmux-256color"
else
  export TERM="xterm-256color"
fi

# Block escape sequences from becoming commands
preexec() {
  [[ "$1" =~ '^_G|Ptmux|^\[' ]] && return 1
}

export CLAUDE_CODE_DISABLE_NONESSENTIAL_RENDERING=1
export CLAUDE_CODE_DISABLE_STREAMING=1
export ENABLE_LSP_TOOL=1

if [[ -d $HOME/.config/zsh/personal_modules ]]; then
  for f in $HOME/.config/zsh/personal_modules/*.zsh(N); do
    source "$f"
  done
fi

if [[ -d $HOME/.config/zsh/work_modules ]]; then
  for f in $HOME/.config/zsh/work_modules/*.zsh(N); do
    source "$f"
  done
fi

# asdf shims must override Homebrew node
export PATH="$HOME/.asdf/shims:$PATH"

# ── Inside Distrobox: strip Nix paths so pacman tools take priority ──
if [[ -f /run/.containerenv ]]; then
  PATH=$(echo "$PATH" | tr ':' '\n' | grep -v '/nix/' | tr '\n' ':' | sed 's/:$//')
fi

test-hibernate() {
  sudo sh -c 'echo test_resume > /sys/power/disk' && sudo systemctl hibernate
}

export PATH="$HOME/.local/bin:$PATH"
