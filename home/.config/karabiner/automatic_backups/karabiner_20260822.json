{
    "profiles": [
        {
            "name": "Default profile",
            "selected": true,
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Caps Lock: hold as Control, tap as Caps Lock",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "caps_lock",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [
                                    {
                                        "key_code": "left_control",
                                        "lazy": true
                                    }
                                ],
                                "to_if_alone": [
                                    { "key_code": "caps_lock" }
                                ]
                            }
                        ]
                    },
                    {
                        "description": "Chrome: Ctrl-Shift-J/K move tabs",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "j",
                                    "modifiers": {
                                        "mandatory": ["control", "shift"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "page_down",
                                        "modifiers": ["control", "shift"]
                                    }
                                ],
                                "conditions": [{ "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.google\\.Chrome$"] }]
                            },
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "k",
                                    "modifiers": {
                                        "mandatory": ["control", "shift"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "page_up",
                                        "modifiers": ["control", "shift"]
                                    }
                                ],
                                "conditions": [{ "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.google\\.Chrome$"] }]
                            }
                        ]
                    },
                    {
                        "description": "Chrome: Ctrl-D bookmark page",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "d",
                                    "modifiers": {
                                        "mandatory": ["control"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [
                                    {
                                        "shell_command": "osascript -e 'tell application \"System Events\" to tell process \"Google Chrome\" to click (first menu item of menu \"Bookmarks\" of menu bar item \"Bookmarks\" of menu bar 1 whose name begins with \"Bookmark This Tab\")'"
                                    }
                                ],
                                "conditions": [{ "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.google\\.Chrome$"] }]
                            }
                        ]
                    },
                    {
                        "description": "Chrome: Ctrl-W close tab",
