#!/usr/bin/env bash

update_var() {
  if pactl list source-outputs 2>/dev/null | grep -qE "firefox|zoom|chromium"; then
    ironbar var set mic "<span color='#f38ba8'> AIR</span>"
  else
    ironbar var set mic ""
  fi
}

case "${1:-watch}" in
  state)
    update_var
    ;;
  watch)
    update_var
    pactl subscribe 2>/dev/null | while read -r line; do
      if echo "$line" | grep -q "source-output"; then
        sleep 0.3
        update_var
      fi
    done
    ;;
  *)
    echo "Usage: $0 [state|watch]"
    ;;
esac
