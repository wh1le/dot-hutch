#!/usr/bin/env bash

PROCESS_NAME="hypridle"

update_var() {
  if pgrep -x "$PROCESS_NAME" >/dev/null; then
    # hypridle running = caffeine off (dim)
    ironbar var set caffeine "<span alpha='40%'>󰾪</span>"
  else
    # hypridle killed = caffeine on (active)
    ironbar var set caffeine "<span color='#a6e3a1'>󰾪</span>"
  fi
}

case "${1:-state}" in
  state)
    update_var
    ;;
  toggle)
    PID=$(pgrep -x "$PROCESS_NAME")
    if [ -z "$PID" ]; then
      hypridle -c "$HOME/.config/hypr/hypridle/hypridle-$(hostname).conf" &>/dev/null & disown
      [[ "$2" == "-n" ]] && notify-send '☕ Cafein' 'Cafein disabled.'
    else
      kill -9 "$PID"
      [[ "$2" == "-n" ]] && notify-send '☕ Cafein' 'Cafein activated.'
    fi
    sleep 0.2
    update_var
    ;;
  watch)
    update_var
    gdbus monitor --system --dest org.freedesktop.login1 \
      --object-path /org/freedesktop/login1 2>/dev/null |
    while read -r line; do
      if echo "$line" | grep -q "PrepareForSleep.*false"; then
        sleep 1
        update_var
      fi
    done
    ;;
  *)
    echo "Usage: $0 [state|toggle|watch]"
    ;;
esac
